import AllThoseEPPA.Applications.KOrientations.Closures

/-!
# The root-determined closure theorem

This module proves the nontrivial direction missing from the purely
formal "root-generated sets are closed" observation.

When every vertex reaches a root, the set

  \`{v | roots(v) ⊆ successorClosure(S)}\`

is the *least* \(d\)-closed subset containing \(S\). To show minimality,
enumerate the (nonempty, finite) set of roots of each vertex as an
injective tuple and invoke the corresponding \(F_n\)-fibre.

This is the exact finite combinatorial statement behind
\`lem:orientations:root-closures\` in the audited LaTeX.
-/

namespace AllThoseEPPA.Applications.KOrientations

universe u

namespace Digraph

variable {V : Type u} [Fintype V] (G : Digraph V)

/-- Every root-generated set is contained in any \(d\)-closed
superset of its generators, provided there are no rootless vertices.

The enumeration of all reachable roots is essential: using a proper
subset of the root set would not justify applying the \(F_n\)-function. -/
theorem dGenerated_minimal (k : ℕ)
    (hRooted : G.HasReachableRoots k)
    (S T : Set V)
    (hST : S ⊆ T)
    (hClosed : G.IsDClosed k T) :
    G.dGenerated k S ⊆ T := by
  classical
  intro v hv
  let R : Type u := {r : V // r ∈ G.roots k v}
  letI : Fintype R := Fintype.ofFinite R
  haveI : Nonempty R := by
    obtain ⟨r, hr⟩ := hRooted v
    exact ⟨⟨r, hr⟩⟩

  let n : ℕ := Fintype.card R
  let e : Fin n ≃ R := (Fintype.equivFin R).symm
  let xs : Fin n → V := fun i => (e i).val

  have hpos : 0 < n := by
    dsimp [n]
    exact Fintype.card_pos

  have hinj : Function.Injective xs := by
    intro i j hij
    apply e.injective
    exact Subtype.ext hij

  have hroots : ∀ i : Fin n, G.IsRoot k (xs i) := by
    intro i
    exact (e i).property.1

  have hrange : Set.range xs = G.roots k v := by
    ext r
    constructor
    · rintro ⟨i, rfl⟩
      exact (e i).property
    · intro hr
      let rr : R := ⟨r, hr⟩
      refine ⟨e.symm rr, ?_⟩
      change (e (e.symm rr)).val = r
      exact congrArg Subtype.val (e.apply_symm_apply rr)

  have hxs : ∀ i : Fin n, xs i ∈ T := by
    intro i
    have hroot : xs i ∈ G.roots k v := (e i).property
    have hsucc : xs i ∈ G.successorClosure S := hv hroot
    obtain ⟨x, hxS, hreach⟩ := hsucc
    exact hClosed.1 x (xs i) (hST hxS) hreach

  have hvFiber : v ∈ G.dFiber k xs := by
    exact ⟨hpos, hinj, hroots, hrange.symm⟩

  exact hClosed.2 n xs hxs hvFiber

/-- Root-set characterization of the closure generated by any set:
extensivity, closedness, and the universal minimality property.

A closure operator satisfying this characterization is unique. -/
theorem dGenerated_universal (k : ℕ)
    (hRooted : G.HasReachableRoots k) (S : Set V) :
    S ⊆ G.dGenerated k S ∧
      G.IsDClosed k (G.dGenerated k S) ∧
      ∀ T : Set V, S ⊆ T → G.IsDClosed k T →
        G.dGenerated k S ⊆ T := by
  exact ⟨G.subset_dGenerated k S,
    G.dGenerated_isDClosed k S,
    fun T hST hT => G.dGenerated_minimal k hRooted S T hST hT⟩

end Digraph

end AllThoseEPPA.Applications.KOrientations
