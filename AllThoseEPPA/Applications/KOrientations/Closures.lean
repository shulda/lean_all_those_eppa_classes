import AllThoseEPPA.Applications.KOrientations.Graph

/-!
# Successor and root-fibre closure operations

This module formalizes the *actual* set-valued functions underlying the
manuscript's \(s\)- and \(d\)-expansions. A root fibre is indexed by
\`xs : Fin n → V\`, as in the arity-indexed general language.

The zero-ary and ill-formed arguments of a root-fibre operation return
the empty set. The \(d\)-generated set defined below is provably
closed under every operation, even before proving the converse
minimality statement (which needs a finite enumeration of root sets).

No field or axiom identifying the root fibre with a smaller set is
assumed: the operation is defined by the equality of root sets.
-/

namespace AllThoseEPPA.Applications.KOrientations

universe u

namespace Digraph

variable {V : Type u} [Fintype V] (G : Digraph V)

/-- The successor closure of any set, including paths of length zero. -/
def successorClosure (S : Set V) : Set V :=
  {v | ∃ u ∈ S, G.Reaches u v}

theorem subset_successorClosure (S : Set V) :
    S ⊆ G.successorClosure S := by
  intro v hv
  exact ⟨v, hv, G.reaches_refl v⟩

theorem successorClosure_closed (S : Set V) {x y : V}
    (hx : x ∈ G.successorClosure S) (hxy : G.Reaches x y) :
    y ∈ G.successorClosure S := by
  rcases hx with ⟨u, hu, hux⟩
  exact ⟨u, hu, G.reaches_trans hux hxy⟩

/-- The value of the \(n\)-ary root-fibre function \(F_n\).

It is nonempty only when \(n>0\) and the input is a tuple of
distinct roots. Its output contains precisely those vertices
whose entire reachable-root set is the input set.
-/
def dFiber (k : ℕ) {n : ℕ} (xs : Fin n → V) : Set V :=
  {v | 0 < n ∧ Function.Injective xs ∧
    (∀ i : Fin n, G.IsRoot k (xs i)) ∧
    G.roots k v = Set.range xs}

theorem mem_dFiber_iff (k : ℕ) {n : ℕ}
    (xs : Fin n → V) (v : V) :
    v ∈ G.dFiber k xs ↔
      0 < n ∧ Function.Injective xs ∧
      (∀ i : Fin n, G.IsRoot k (xs i)) ∧
      G.roots k v = Set.range xs :=
  Iff.rfl

theorem roots_eq_range_of_mem_dFiber (k : ℕ) {n : ℕ}
    {xs : Fin n → V} {v : V}
    (hv : v ∈ G.dFiber k xs) :
    G.roots k v = Set.range xs := by
  exact hv.2.2.2

theorem root_of_mem_dFiber (k : ℕ) {n : ℕ}
    {xs : Fin n → V} {v : V}
    (hv : v ∈ G.dFiber k xs) (i : Fin n) :
    G.IsRoot k (xs i) :=
  hv.2.2.1 i

/-- A set is closed under successor closure and every \(F_n\)-fibre. -/
def IsDClosed (k : ℕ) (T : Set V) : Prop :=
  (∀ x y : V, x ∈ T → G.Reaches x y → y ∈ T) ∧
  (∀ (n : ℕ) (xs : Fin n → V),
    (∀ i : Fin n, xs i ∈ T) → G.dFiber k xs ⊆ T)

/-- Root-set criterion for the \(d\)-closure generated by \(S\).
The exact minimality statement is a later theorem; this is its
canonical right-hand side. -/
def dGenerated (k : ℕ) (S : Set V) : Set V :=
  {v | G.roots k v ⊆ G.successorClosure S}

theorem subset_dGenerated (k : ℕ) (S : Set V) :
    S ⊆ G.dGenerated k S := by
  intro v hv r hr
  exact ⟨v, hv, hr.2⟩

/-- The root-set criterion is closed under directed successors. -/
theorem dGenerated_closed_successors (k : ℕ) (S : Set V)
    {x y : V} (hx : x ∈ G.dGenerated k S)
    (hxy : G.Reaches x y) :
    y ∈ G.dGenerated k S := by
  intro r hr
  exact hx (G.roots_antitone k hxy hr)

/-- The root-set criterion is closed under all \(d\)-fibres. -/
theorem dGenerated_closed_fiber (k : ℕ) (S : Set V)
    {n : ℕ} (xs : Fin n → V)
    (hxs : ∀ i, xs i ∈ G.dGenerated k S)
    {v : V} (hv : v ∈ G.dFiber k xs) :
    v ∈ G.dGenerated k S := by
  intro r hr
  have hrange : r ∈ Set.range xs := by
    rw [← G.roots_eq_range_of_mem_dFiber k hv]
    exact hr
  rcases hrange with ⟨i, rfl⟩
  exact hxs i (G.root_mem_own_roots k (G.root_of_mem_dFiber k hv i))

/-- An exact closure property, not just a monotonicity observation. -/
theorem dGenerated_isDClosed (k : ℕ) (S : Set V) :
    G.IsDClosed k (G.dGenerated k S) := by
  constructor
  · intro x y hx hxy
    exact G.dGenerated_closed_successors k S hx hxy
  · intro n xs hxs v hv
    exact G.dGenerated_closed_fiber k S xs hxs hv

end Digraph

end AllThoseEPPA.Applications.KOrientations
