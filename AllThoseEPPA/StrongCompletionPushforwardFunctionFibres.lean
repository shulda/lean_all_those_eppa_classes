import AllThoseEPPA.StrongCompletionPushforward
import AllThoseEPPA.StrongCompletionKernelClosure

/-!
# Exact function fibres in existential quotient structures

For q : V → U, the existential pushforward q₊A makes q a
Γ-homomorphism. In a language with *set-valued* functions,
being a homomorphism is strictly weaker than being a
homomorphism-embedding: the pushforward may add function
values at a tuple because a different tuple has the same
q-image.

The exact and readily checkable obstruction is
`FunctionFibresCompatible A q`: whenever two tuples are
identified by q, the **sets of q-images of their function
values must coincide**.

We prove that this compatibility is equivalent to global
function-fibre exactness of the canonical quotient map.
It additionally shows that the quotient preserves images
of all function-closed sets and commutes with *all* generated
closures. This is useful for the irreducible-piece analysis
needed for Proposition 11.3.

The full homomorphism-embedding criterion is separately proved
in the parallel factor-quotient branch, without duplicating
its proof here.
-/

namespace AllThoseEPPA
namespace Structure

universe u v w x y
variable {L : Language.{u}} {Γ : Type v} [Group Γ]
variable {V : Type w} {U : Type x} {W : Type y}

/-- Congruence condition on genuine set-valued function fibres
under an arbitrary vertex quotient q.

Two input tuples identified by q must produce exactly the
same set of q-images of function values. There is no restriction
on arities or on the cardinalities of the carrier types. -/
def FunctionFibresCompatible
    (A : Structure L V) (q : V → U) : Prop :=
  ∀ {n : ℕ} (F : L.FuncSymbol n)
    (xs ys : Fin n → V),
    q ∘ xs = q ∘ ys →
      imageSet q (A.func F xs) = imageSet q (A.func F ys)

/-- If function fibres are quotient-compatible, existential
pushforward introduces **no new function values** for any
particular input tuple. -/
theorem pushforward_func_eq_of_compatible
    (A : Structure L V) (q : V → U)
    (hCompat : A.FunctionFibresCompatible q)
    {n : ℕ} (F : L.FuncSymbol n)
    (xs : Fin n → V) :
    imageSet q (A.func F xs) =
      (A.pushforwardAlong q).func F (q ∘ xs) := by
  ext z
  constructor
  · intro hz
    exact ⟨xs, rfl, hz⟩
  · intro hz
    change (∃ ys : Fin n → V,
      q ∘ ys = q ∘ xs ∧ z ∈ imageSet q (A.func F ys)) at hz
    obtain ⟨ys, hys, hval⟩ := hz
    rw [hCompat F ys xs hys] at hval
    exact hval

/-- Conversely, exact function preservation by q on all
source tuples forces compatibility of their q-images.
Thus fibre compatibility captures *exactly* the missing
function part of being a homomorphism-embedding. -/
theorem functionFibresCompatible_of_pushforward_exact
    (A : Structure L V) (q : V → U)
    (hExact : ∀ {n : ℕ} (F : L.FuncSymbol n)
      (xs : Fin n → V),
      imageSet q (A.func F xs) =
        (A.pushforwardAlong q).func F (q ∘ xs)) :
    A.FunctionFibresCompatible q := by
  intro n F xs ys heq
  calc
    imageSet q (A.func F xs) =
        (A.pushforwardAlong q).func F (q ∘ xs) := hExact F xs
    _ = (A.pushforwardAlong q).func F (q ∘ ys) := by rw [heq]
    _ = imageSet q (A.func F ys) := (hExact F ys).symm


/-- Images of arbitrary function-closed vertex sets remain
function-closed in the existential quotient whenever its
function fibres satisfy the genuine congruence equation.

This fact is stronger than exactness on irreducible pieces:
it identifies the complete closure geometry of the quotient,
including closures generated by any set of vertices. -/
theorem pushforward_image_isClosed_of_compatible
    (A : Structure L V) (q : V → U)
    (hCompat : A.FunctionFibresCompatible q)
    (S : Set V) (hS : A.IsClosed S) :
    (A.pushforwardAlong q).IsClosed (imageSet q S) := by
  classical
  intro n F xs hxs z hz
  choose as has using hxs
  have hTuple : q ∘ as = xs := by
    funext i
    exact (has i).2
  change (∃ ys : Fin n → V,
    q ∘ ys = xs ∧ z ∈ imageSet q (A.func F ys)) at hz
  obtain ⟨bs, hbs, hVal⟩ := hz
  have hSame : q ∘ bs = q ∘ as := hbs.trans hTuple.symm
  have hNew : z ∈ imageSet q (A.func F as) := by
    rw [← hCompat F bs as hSame]
    exact hVal
  obtain ⟨a, ha, hqa⟩ := hNew
  exact ⟨a, hS F as (fun i => (has i).1) ha, hqa⟩

/-- Quotient by a congruence commutes with **arbitrary generated
closures**, not just one-point closures. Surjectivity and
global injectivity of the vertex map are unnecessary. -/
theorem pushforward_image_closureSet_eq_of_compatible
    (act : L.Action Γ)
    (A : Structure L V) (q : V → U)
    (hCompat : A.FunctionFibresCompatible q)
    (S : Set V) :
    imageSet q (A.closureSet S) =
      (A.pushforwardAlong q).closureSet (imageSet q S) := by
  apply Set.Subset.antisymm
  · exact (Homomorphism.toPushforward act A q).image_closureSet_subset_closureSet
      act S
  · apply (A.pushforwardAlong q).closureSet_minimal
      (A.pushforward_image_isClosed_of_compatible q hCompat
        (A.closureSet S) (A.isClosed_closureSet S))
    intro y hy
    obtain ⟨x, hx, hxy⟩ := hy
    exact ⟨x, A.subset_closureSet S hx, hxy⟩
end Structure
end AllThoseEPPA
